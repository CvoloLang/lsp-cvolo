<Project>
  <!--
    Compiler compatibility line: the compiler line this LanguageServer release
    supports. compiler-compatibility.version is the single committed source of
    truth, so the value is read from that file rather than repeated as a literal.
    The pinned tooling bundle in tooling.version carries the same line in its
    tooling.manifest.json; the release pipeline fails when the two disagree.
    The LanguageServer product version in <Version> below is deliberately
    independent of both.
  -->
  <PropertyGroup>
    <CompilerCompatibilityLineFile>$(MSBuildThisFileDirectory)compiler-compatibility.version</CompilerCompatibilityLineFile>
    <CompilerCompatibilityLine Condition="Exists('$(CompilerCompatibilityLineFile)')">$([System.IO.File]::ReadAllText('$(CompilerCompatibilityLineFile)').Trim())</CompilerCompatibilityLine>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0-alpha.13</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <!--
      Keep the product version exact. The build SHA is provenance, not part of the
      product identity, so it is carried by the bundle manifest instead of being
      appended to the informational version as "+<commit>".
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="RequireCompilerCompatibilityLine" BeforeTargets="PrepareForBuild" Condition="'$(CompilerCompatibilityLine)' == ''">
    <Error Text="compiler-compatibility.version is missing or empty. It must contain the compiler line this LanguageServer release supports, for example 0.0.21." />
  </Target>
  <!-- All projects compile against the same verified Tooling bundle assemblies.
       Generated only by fetch-tooling or use-development-tooling; never committed. -->
  <Import Project="$(MSBuildThisFileDirectory)artifacts/tooling-dir.props"
          Condition="Exists('$(MSBuildThisFileDirectory)artifacts/tooling-dir.props')" />

  <!-- Tooling 0.0.21.2 was released before the observability assemblies were
       included in its runtime payload. A CI-built development bundle includes
       them; local developers using the older verified release may temporarily
       build the matching source projects from the sibling Compiler checkout.
       Never use an unpinned source fallback in CI or release packaging. -->
  <PropertyGroup>
    <CvoloLocalCompilerRoot Condition="'$(CvoloLocalCompilerRoot)' == ''">$(MSBuildThisFileDirectory)..\Cvolo\</CvoloLocalCompilerRoot>
    <CvoloObservabilityBundled Condition="'$(CvoloToolingDir)' != '' and Exists('$(CvoloToolingDir)/Cvolo.Observability.Abstractions.dll') and Exists('$(CvoloToolingDir)/Cvolo.Observability.dll')">true</CvoloObservabilityBundled>
    <CvoloObservabilityUseLocalSource
        Condition="'$(CvoloObservabilityBundled)' != 'true' and '$(ContinuousIntegrationBuild)' != 'true'
            and Exists('$(CvoloLocalCompilerRoot)src/Cvolo.Observability.Abstractions/Cvolo.Observability.Abstractions.csproj')
            and Exists('$(CvoloLocalCompilerRoot)src/Cvolo.Observability/Cvolo.Observability.csproj')">true</CvoloObservabilityUseLocalSource>
  </PropertyGroup>

  <Target Name="EnsureObservabilityReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CvoloObservabilityBundled)' != 'true' and '$(CvoloObservabilityUseLocalSource)' != 'true'"
           Text="Required Cvolo.Observability assemblies are missing from the verified Tooling bundle at '$(CvoloToolingDir)'. Use a Tooling bundle that contains both Cvolo.Observability.dll and Cvolo.Observability.Abstractions.dll. For local development only, keep the Compiler source checkout beside LanguageServer at '$(CvoloLocalCompilerRoot)' (or set -p:CvoloLocalCompilerRoot=...). CI and release builds never use this source fallback." />
  </Target>
</Project>
