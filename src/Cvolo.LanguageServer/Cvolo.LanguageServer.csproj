<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cvolo-language-server</AssemblyName>
    <RootNamespace>Cvolo.LanguageServer</RootNamespace>
    <ServerName>cvolo-language-server</ServerName>
  </PropertyGroup>

  <!-- Tooling location is produced by build/fetch-tooling.ps1|.sh. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\artifacts\tooling-dir.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\tooling-dir.props')" />

  <PropertyGroup>
    <CvoloManagedToolingAvailable Condition="'$(CvoloToolingDir)' != '' and Exists('$(CvoloToolingDir)/Cvolo.Compiler.Tooling.dll')">true</CvoloManagedToolingAvailable>
    <CvoloManagedToolingAvailable Condition="'$(CvoloManagedToolingAvailable)' == ''">false</CvoloManagedToolingAvailable>
    <DefineConstants Condition="'$(CvoloManagedToolingAvailable)' == 'true'">$(DefineConstants);CVOLO_MANAGED_TOOLING</DefineConstants>
  </PropertyGroup>

  <Target Name="EnsureToolingRestored"
          BeforeTargets="ResolveReferences"
          Condition="'$(CvoloToolingDir)' == ''">
    <Error Text="Cvolo.Compiler.Tooling is not restored at $(MSBuildThisFileDirectory)..\..\artifacts\tooling. Run build/fetch-tooling.ps1 (Windows) or build/fetch-tooling.sh (POSIX) from the repository root before building." />
  </Target>

  <!--
    Embed the full build identity into the assembly so the runtime and the release
    manifest can report exactly what was built, without ever reading the artifacts
    directory or the working tree.

    The LanguageServer product version is NOT embedded here: it is the assembly
    InformationalVersion, taken from <Version>. Because the product version must stay
    a clean SemVer, IncludeSourceRevisionInInformationalVersion is disabled in
    Directory.Build.props and provenance travels in its own fields instead.

    LanguageServerCommit is supplied explicitly by the release pipeline
    (-p:LanguageServerCommit=<sha>) after it has proved the checkout HEAD equals the
    peeled release tag. A plain local build falls back to SourceRevisionId, and then to
    "unknown"; the release manifest generator rejects a non-SHA value, so an
    unprovenanced build can never be published.
  -->
  <Target Name="EmitBuildMetadata" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_EffectiveLanguageServerCommit Condition="'$(LanguageServerCommit)' != ''">$(LanguageServerCommit)</_EffectiveLanguageServerCommit>
      <_EffectiveLanguageServerCommit Condition="'$(_EffectiveLanguageServerCommit)' == '' and '$(SourceRevisionId)' != ''">$(SourceRevisionId)</_EffectiveLanguageServerCommit>
      <_EffectiveLanguageServerCommit Condition="'$(_EffectiveLanguageServerCommit)' == ''">unknown</_EffectiveLanguageServerCommit>
      <_EffectiveRuntimeVersion Condition="'$(BundledNETCoreAppPackageVersion)' != ''">$(BundledNETCoreAppPackageVersion)</_EffectiveRuntimeVersion>
    </PropertyGroup>
    <Warning Condition="'$(LanguageServerCommit)' == '' and '$(SourceRevisionId)' == ''"
             Text="No LanguageServerCommit build property and no SourceRevisionId: the build provenance will be 'unknown'. Release builds pass -p:LanguageServerCommit explicitly." />
    <ItemGroup>
      <AssemblyMetadata Include="LanguageServerCommit" Value="$(_EffectiveLanguageServerCommit)" />
      <AssemblyMetadata Include="TargetFramework" Value="$(TargetFramework)" />
      <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" />
      <AssemblyMetadata Include="RuntimeVersion" Value="$(_EffectiveRuntimeVersion)" />
    </ItemGroup>
  </Target>

  <!--
    Tooling metadata. The tooling version is the exact revision pinned by
    tooling.version and tooling commit is the commit that tooling bundle was built
    from; the compiler compatibility line is the single committed value from
    compiler-compatibility.version, which the pinned tooling manifest must match.
  -->
  <Target Name="EmitToolingMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'$(CvoloToolingVersion)' != ''">
    <ItemGroup>
      <AssemblyMetadata Include="ToolingVersion" Value="$(CvoloToolingVersion)" />
      <AssemblyMetadata Include="ToolingCommit" Value="$(ToolingCommit)" />
      <AssemblyMetadata Include="CompilerCompatibilityLine" Value="$(CompilerCompatibilityLine)" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(CvoloManagedToolingAvailable)' == 'true'">
    <Reference Include="Cvolo.Compiler.Tooling">
      <HintPath>$(CvoloToolingDir)/Cvolo.Compiler.Tooling.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cvolo.LanguageServer.Core\Cvolo.LanguageServer.Core.csproj" />
    <ProjectReference Include="..\Cvolo.LanguageServer.Cvolo\Cvolo.LanguageServer.Cvolo.csproj" />
    <!--
      Observability contracts and runtime are consumed as source references to the sibling
      compiler checkout until the pinned tooling bundle ships these assemblies. Stage 7
      replaces this with bundle presence/load/type-identity checks plus manifest versions.
    -->
    <ProjectReference Include="..\..\..\Cvolo\src\Cvolo.Observability.Abstractions\Cvolo.Observability.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Cvolo\src\Cvolo.Observability\Cvolo.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Ship the verified pinned tooling bundle beside the executable. The
       runtime loader resolves Cvolo.Compiler.Tooling.dll from AppContext.BaseDirectory. -->
  <Target Name="CopyToolingRuntimeDeps" AfterTargets="Build;Publish" Condition="'$(CvoloToolingDir)' != ''">
    <ItemGroup>
      <_ToolingRuntime Include="$(CvoloToolingDir)\**\*"
                       Condition="Exists('$(CvoloToolingDir)')" />
    </ItemGroup>
    <!-- The runtime loads Cvolo.Compiler.Tooling.dll (and the standard library it needs)
         from the application base directory, so the tooling bundle is copied beside the
         executable as well as into the publish output. -->
    <Copy SourceFiles="@(_ToolingRuntime)"
          DestinationFolder="$(OutputPath)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ToolingRuntime)"
          DestinationFolder="$(PublishDir)%(RecursiveDir)"
          Condition="'$(PublishDir)' != ''"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
