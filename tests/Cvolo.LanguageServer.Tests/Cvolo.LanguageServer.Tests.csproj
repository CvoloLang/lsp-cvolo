<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cvolo.LanguageServer\Cvolo.LanguageServer.csproj" />
    <ProjectReference Include="..\..\src\Cvolo.LanguageServer.Core\Cvolo.LanguageServer.Core.csproj" />
    <ProjectReference Include="..\..\src\Cvolo.LanguageServer.Cvolo\Cvolo.LanguageServer.Cvolo.csproj" />
    <!-- Test against the runtime shipped in the same verified Tooling bundle. -->
    <Reference Include="Cvolo.Observability.Abstractions">
      <HintPath>$(CvoloToolingDir)/Cvolo.Observability.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cvolo.Observability">
      <HintPath>$(CvoloToolingDir)/Cvolo.Observability.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Compile-time access to the pinned tooling for backend assertions. The
       runtime copy is delivered to the test output by CopyServerOutputForProcessTests. -->
  
  <PropertyGroup>
    <CvoloManagedToolingAvailable Condition="'$(CvoloToolingDir)' != '' and Exists('$(CvoloToolingDir)/Cvolo.Compiler.Tooling.dll')">true</CvoloManagedToolingAvailable>
    <CvoloManagedToolingAvailable Condition="'$(CvoloManagedToolingAvailable)' == ''">false</CvoloManagedToolingAvailable>
  </PropertyGroup>
  <ItemGroup Condition="'$(CvoloManagedToolingAvailable)' == 'true'">
    <Reference Include="Cvolo.Compiler.Tooling">
      <HintPath>$(CvoloToolingDir)/Cvolo.Compiler.Tooling.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(CvoloManagedToolingAvailable)' != 'true'">
    <Compile Remove="Backend\CvoloLanguageBackendTests.cs" />
    <Compile Remove="Backend\CvoloDiagnosticAdapterTests.cs" />
    <Compile Remove="Protocol\TextDocumentSyncHandlerTests.cs" />
    <Compile Remove="Diagnostics\DiagnosticPublicationTests.cs" />
    <Compile Remove="Diagnostics\CrossFileDiagnosticTests.cs" />
    <Compile Remove="EndToEnd\DiagnosticProcessTests.cs" />
  </ItemGroup>
  <!--
    Process-level tests spawn the real server executable. Project references
    only copy the managed assembly, so mirror the entire server output (apphost,
    runtimeconfig, deps, tooling bundle dlls) into the test output.
  -->
  <Target Name="CopyServerOutputForProcessTests" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Cvolo.LanguageServer\Cvolo.LanguageServer.csproj"
             Targets="GetTargetPath;GetCopyToOutputDirectoryItems"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ServerOutputItems" />
    </MSBuild>
    <ItemGroup>
      <_ServerTargetPath Include="@(_ServerOutputItems)" Condition="'%(Filename)' == 'cvolo-language-server' and '%(Extension)' == '.dll'" />
      <_ServerDependency Include="@(_ServerOutputItems)" Condition="'%(Filename)' != 'cvolo-language-server' or '%(Extension)' != '.dll'" />
      <_ServerOutputDirectory Include="@(_ServerTargetPath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <PropertyGroup>
      <_ServerOutput>@(_ServerOutputDirectory->'%(Identity)')</_ServerOutput>
      <_ServerFileName>@(_ServerTargetPath->'%(Filename)')</_ServerFileName>
    </PropertyGroup>
    <Copy SourceFiles="@(_ServerTargetPath)"
          DestinationFiles="@(_ServerTargetPath->'$(OutputPath)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ServerDependency)"
          DestinationFiles="@(_ServerDependency->'$(OutputPath)%(TargetPath)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName).exe" Condition="Exists('$(_ServerOutput)$(_ServerFileName).exe')" />
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName)" Condition="Exists('$(_ServerOutput)$(_ServerFileName)')" />
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName).dll" Condition="Exists('$(_ServerOutput)$(_ServerFileName).dll')" />
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName).deps.json" Condition="Exists('$(_ServerOutput)$(_ServerFileName).deps.json')" />
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName).runtimeconfig.json" Condition="Exists('$(_ServerOutput)$(_ServerFileName).runtimeconfig.json')" />
      <_ServerGeneratedFiles Include="$(_ServerOutput)$(_ServerFileName).pdb" Condition="Exists('$(_ServerOutput)$(_ServerFileName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ServerGeneratedFiles)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(CvoloToolingDir)' != '' and Exists('$(CvoloToolingDir)')">
      <_ToolingFiles Include="$(CvoloToolingDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ToolingFiles)"
          DestinationFiles="@(_ToolingFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
